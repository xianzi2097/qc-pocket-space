# ================= 全局配置：定义插件执行顺序 =================
# 注意：这部分必须在文件的最顶端！
{
    order webdav before file_server
}

# ================= 你的网站配置 =================
# 此文件由 generate_caddyfile.py 自动生成，请勿手动编辑！
# 路径和域名通过 Python 脚本注入绝对路径。
{{SITE_DOMAIN_LIST}} {
    # www → 主域名 301 跳转
    @www {
        host www.{{SITE_DOMAIN}}
    }
    redir @www https://{{SITE_DOMAIN}}{uri}
    encode gzip zstd
	
    # 0.后端大脑：把所有 /api/ 开头的流量，拦截下来交给 FastAPI
    reverse_proxy /api/* localhost:{{FASTAPI_PORT}}
    
    # 1. 默认根目录：公开主页（4 卡片布局，低年级入口）
    root * "{{SITE_PATH}}/dashboard"
    file_server

    # ================= 强化跨域配置 (保持不变) =================
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "*"
        Access-Control-Expose-Headers "*"
    }
    
    @options {
        method OPTIONS
    }
    respond @options 200
    # ===============================================

    # 2. 学习手册：映射到 VitePress 打包目录
    handle_path /docs/* {
        root * "{{SITE_PATH}}/vitepress_dist"
        file_server
    }

    # 3. 核心素材共享（data/courses/）
    handle_path /share/* {
        root * "{{DATA_PATH}}/courses"
        @get method GET HEAD
        handle @get {
            file_server browse
        }
        handle {
            webdav
        }
    }
	
    # 4. 用户数据（独立 data/ 目录，git 外）
    handle_path /users/* {
        root * "{{DATA_PATH}}/users"
        @get method GET HEAD
        handle @get {
            file_server browse
        }
        handle {
            webdav
        }
    }

    # 5. 电子教室路由
    handle_path /classroom/* {
        root * "{{SITE_PATH}}/classroom"
        file_server
    }

    # 6. Scratch 在线编辑器前端
    handle_path /Scratch/* {
        root * "{{SITE_PATH}}/scratch_dist"
        try_files {path} /index.html
        file_server
    }

    # 7. React 后台看板（SPA，需要 try_files 兜底）
    handle_path /dashboard/* {
        root * "{{SITE_PATH}}/dashboard"
        try_files {path} /index.html
        file_server
    }
}
